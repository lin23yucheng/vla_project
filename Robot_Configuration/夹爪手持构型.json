{
  "schema_version": "1.0",                 
  "robot_type": "dual_arm_gripper_v1",       
  "robot_name": "双臂夹爪机器人",             
  "description": "双臂、双腕相机、双夹爪、末端位姿控制",
  "main_time_topic": "/sensor/camera_fisheye_r/color/image_raw",
  "cameras": [
    {
      "key": "observation.images.left_image",
      "name": "left_image",
      "topic": "/sensor/camera_fisheye_l/color/image_raw", 
      "role": "image",
      "type": "wrist",
      "required": true,                     
      "encoding": "rgb",                   
      "sync_policy": "3",         
      "output_video": true,                
      "video_dir": "observation.images.left_image",
      "group": "left"
    },
    {
      "key": "observation.images.right_image",
      "name": "right_image",
      "topic": "/sensor/camera_fisheye_r/color/image_raw", 
      "role": "image",
      "type": "wrist",
      "required": true,                     
      "encoding": "rgb",                   
      "sync_policy": "3",         
      "output_video": true,                
      "video_dir": "observation.images.right_image",
      "group": "right"
    }
  ],

  "observation_state": [
    {
      "name": "left_joint_states",           
      "topic": "/pika_pose_l",
      "role": "joint_state",             
      "parser": "pose7d",                    
      "dtype": "float32",             
      "fields": ["pose.position.x", "pose.position.y", "pose.position.z", "pose.orientation.x", "pose.orientation.y", "pose.orientation.z", "pose.orientation.w"],
      "shape": [7],
      "trigger_fields": ["pose.position.x", "pose.position.y", "pose.position.z"],
      "trigger_parser": "location3d",
      "trigger_shape": [3],               
      "required": true,                 
      "sync_policy": "3",           
      "missing_policy": "fill",
      "group": "left"
    },
    {
      "name": "left_gripper",
      "topic": "/sensor/gripper_l/data",
      "role": "end_effector",
      "parser": "gripper",
      "dtype": "float32",
      "fields": ["angle"],
      "shape": [1],
      "trigger_fields": ["angle"],
      "trigger_parser": "gripper",
      "trigger_shape": [1],
      "required": true,
      "sync_policy": "3",
      "missing_policy": "fill",
      "group": "left"
    },
    {
      "name": "right_joint_states",            
      "topic": "/pika_pose_r", 
      "role": "joint_state", 
      "parser": "pose7d",                  
      "dtype": "float32",                  
      "fields": ["pose.position.x", "pose.position.y", "pose.position.z", "pose.orientation.x", "pose.orientation.y", "pose.orientation.z", "pose.orientation.w"],
      "shape": [7],
      "trigger_fields": ["pose.position.x", "pose.position.y", "pose.position.z"],
      "trigger_parser": "location3d",
      "trigger_shape": [3],
      "required": true,                   
      "sync_policy": "3",            
      "missing_policy": "fill",
      "group": "right"
    },
    {
      "name": "right_gripper",
      "topic": "/sensor/gripper_r/data",
      "role": "end_effector",
      "parser": "gripper",
      "dtype": "float32",
      "fields": ["angle"],
      "shape": [1],
      "trigger_fields": ["angle"],
      "trigger_parser": "gripper",
      "trigger_shape": [1],
      "required": true,
      "sync_policy": "3",
      "missing_policy": "fill",
      "group": "right"
    }
  ],

  "action": [
    {
      "name": "left_joint_states",           
      "topic": "/pika_pose_l",
      "role": "joint_state",             
      "parser": "pose7d",                    
      "dtype": "float32",             
      "fields": ["pose.position.x", "pose.position.y", "pose.position.z", "pose.orientation.x", "pose.orientation.y", "pose.orientation.z", "pose.orientation.w"],
      "shape": [7],
      "trigger_fields": ["pose.position.x", "pose.position.y", "pose.position.z"],
      "trigger_parser": "location3d",
      "trigger_shape": [3],               
      "required": true,                 
      "sync_policy": "3",           
      "missing_policy": "fill",       
      "group": "left"
    },
    {
      "name": "left_gripper",
      "topic": "/sensor/gripper_l/data",
      "role": "end_effector",
      "parser": "gripper",
      "dtype": "float32",
      "fields": ["angle"],
      "shape": [1],
      "trigger_fields": ["angle"],
      "trigger_parser": "gripper",
      "trigger_shape": [1],
      "required": true,
      "sync_policy": "3",
      "missing_policy": "fill",
      "group": "left"
    },
    {
      "name": "right_joint_states",            
      "topic": "/pika_pose_r", 
      "role": "joint_state", 
      "parser": "pose7d",                  
      "dtype": "float32",                  
      "fields": ["pose.position.x", "pose.position.y", "pose.position.z", "pose.orientation.x", "pose.orientation.y", "pose.orientation.z", "pose.orientation.w"],
      "shape": [7],
      "trigger_fields": ["pose.position.x", "pose.position.y", "pose.position.z"],
      "trigger_parser": "location3d",
      "trigger_shape": [3],
      "required": true,                   
      "sync_policy": "3",
      "missing_policy": "fill",
      "group": "right"
    },
    {
      "name": "right_gripper",
      "topic": "/sensor/gripper_r/data",
      "role": "end_effector",
      "parser": "gripper",
      "dtype": "float32",
      "fields": ["angle"],
      "shape": [1],
      "trigger_fields": ["angle"],
      "trigger_parser": "gripper",
      "trigger_shape": [1],
      "required": true,
      "sync_policy": "3",
      "missing_policy": "fill",
      "group": "right"
    }
  ]
}
